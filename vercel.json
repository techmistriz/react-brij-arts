{
  "redirects": [
    {
      "source": "/academy",
      "destination": "/academy/fellowship",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/academy/fellowship",
      "destination": "/index.html"
    },
    {
      "source": "/academy/fellowship/:path((?!assets).*)",
      "destination": "/index.html"
    }
  ]
}